[Unit]
Description=Iddawela Foundation site (preview)
After=network.target postgresql.service

[Service]
User=iddawela
Group=iddawela
WorkingDirectory=/opt/iddawela/app/server
EnvironmentFile=/etc/iddawela/server.env
ExecStart=/opt/iddawela/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8820 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
Nice=5
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/iddawela/data

[Install]
WantedBy=multi-user.target
